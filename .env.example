# Copy to .env and fill in. Never commit the real one.
HOMEBOT_TOKEN=123456:replace-with-token-from-botfather
HOMEBOT_OWNERS=111111111,222222222
# Guests see the TV remote and nothing else — no cameras, no archive, no settings
HOMEBOT_GUESTS=333333333

# The TV, if you have one wired to the same network. Leave empty to run without it.
# The MAC is only needed for Wake-on-LAN, and only works on cable.
HOMEBOT_TV_IP=192.168.1.100
HOMEBOT_TV_MAC=00:00:00:00:00:00
HOMEBOT_TV_NAME=Living room TV
